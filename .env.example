# Export these in your shell (e.g. `set -a; source .env; set +a`); the code
# does not load a .env file by itself. Never commit real credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: force the local backend (auto, cuda, mps or cpu). Read by
# llm_textgen_lab/device.py; it overrides --device.
LLM_TEXTGEN_DEVICE=auto
